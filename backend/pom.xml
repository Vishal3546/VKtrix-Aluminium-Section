<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.app</groupId>
    <artifactId>aluminium-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Aluminium Section Application</name>
    <description>Monorepo backend for Aluminium Section Application</description>

    <modules>
        <module>party</module>
        <module>project</module>
        <module>design</module>
        <module>profile</module>
        <module>quotation</module>
        <module>cutting</module>
        <module>inventory</module>
        <module>production</module>
        <module>application</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Explicitly force Lombok version to avoid IDE cache/resolution issues -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!-- Submodules dependencies -->
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>party</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>design</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>profile</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>quotation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>cutting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>inventory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.app</groupId>
                <artifactId>production</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
